# Console and flashing on the native USB-Serial-JTAG port (USB-C). That leaves
# UART1 free for the CYD link on GPIO9/GPIO10.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000

# XIAO ESP32-C5 has 8 MB of flash (the boot log showed the 2 MB header mismatch).
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Custom table: 3 MB factory app (no OTA), see partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Power management: lets charge mode drop the CPU clock to 80 MHz.
CONFIG_PM_ENABLE=y

# Bluetooth LE through NimBLE (passive scanning; GATT connect arrives with M6).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
